APP_NAME=AgTech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LEGACY_APP_URL=http://localhost:8001
# On the legacy PHP server, set AGTECH_MODERN_APP_URL if the Laravel app uses a different URL.
AGTECH_CONTACT_EMAIL=theagtechteam@gmail.com

# Homepage content approved for public display. Leave blank to hide either section.
# Demo values for local previews only. Replace with approved content before publishing.
# AGTECH_PUBLIC_LISTINGS='[{"product":"Native chickens","category":"chickens","municipality":"Camalig, Albay","availability":"Demo listing · 12 birds"},{"product":"Fresh chicken eggs","category":"eggs","municipality":"Guinobatan, Albay","availability":"Demo listing · 6 trays"},{"product":"Grower pigs","category":"pigs","municipality":"Daraga, Albay","availability":"Demo listing · 3 pigs"}]'
# AGTECH_APPROVED_SPOTLIGHT='{"name":"Sample profile","role":"Backyard poultry farmer (demo)","story":"This fictional spotlight shows how a farmer could share their experience raising chickens and coordinating local pickups.","quote":"I check how many eggs I have before confirming a pickup with a buyer.","photo":"https://placehold.co/640x400/20372a/eff8f1.png?text=AgTech+Demo+Spotlight"}'
# Optional listing categories for stock photos: chickens, eggs, pigs.
# The spotlight photo must be a public HTTPS URL.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agtech
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
